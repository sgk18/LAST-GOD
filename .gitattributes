# Unity text assets — enforce LF in repo, convert on checkout for Windows
* text=auto

# Unity YAML assets — treat as text (so diffs are readable)
*.cs        text eol=lf
*.js        text eol=lf
*.meta      text eol=lf
*.unity     text eol=lf
*.asset     text eol=lf
*.prefab    text eol=lf
*.anim      text eol=lf
*.asmdef    text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.inputactions text eol=lf
*.shader    text eol=lf
*.hlsl      text eol=lf
*.cginc     text eol=lf

# Binary assets — never diff/merge
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.psd       binary
*.wav       binary
*.mp3       binary
*.ogg       binary
*.fbx       binary
*.dll       binary
*.so        binary
*.dylib     binary
