# DO NOT add *.meta to gitignore

# ─── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── IDEs ─────────────────────────────────────────────────────────────────────
.vs/
.vscode/
.idea/
*.suo
*.user

# ─── Solution / project files (Unity regenerates these) ──────────────────────
*.sln
*.csproj
*.unityproj

# ─── Crash / analytics ────────────────────────────────────────────────────────
sysinfo.txt
*.stackdump
*.log
crashlytics-build.properties

# ─── Stray Unity projects at repo root (keep only LAST-GOD/) ─────────────────
/My project/
